{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "littlechest",
  "compatibility_date": "2025-05-25",
  "main": "src/_worker.js",
  "assets": {
    "not_found_handling": "single-page-application",
    "directory": "./public/",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
